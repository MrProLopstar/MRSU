<resources>
    <style name="Theme.MRSU.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Поверхности -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Текст -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray_light</item>

        <!-- Системные элементы -->
        <item name="android:statusBarColor">@color/dark_primary_variant</item>
        <item name="android:navigationBarColor">@color/dark_primary</item>

        <!-- Нижняя навигация -->
        <item name="bottomNavigationStyle">@style/BottomNavigationViewStyle.Dark</item>
    </style>
</resources>
