<resources>
    <style name="BottomNavigationViewStyle" parent="Widget.Design.BottomNavigationView">
        <item name="itemIconTint">@color/color_selector</item>
        <item name="itemTextColor">@color/color_selector</item>
        <item name="android:background">@color/bottom_nav_background</item>
    </style>

    <style name="BottomNavigationViewStyle.Dark" parent="Widget.Design.BottomNavigationView">
        <item name="itemIconTint">@color/color_selector_dark</item>
        <item name="itemTextColor">@color/color_selector_dark</item>
        <item name="android:background">@color/dark_surface</item>
    </style>

    <style name="CalendarDayStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#6A6A6A</item>
    </style>

    <style name="Widget.AppCompat.Toolbar" parent="Base.Widget.AppCompat.Toolbar">
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetEnd">0dp</item>
        <item name="contentInsetLeft">0dp</item>
        <item name="contentInsetRight">0dp</item>
    </style>
</resources>
